{
  "info": {
    "_postman_id": "25509c88-4adc-4295-8e9d-d67cdf73e606",
    "name": "KLT Cyber website API v1",
    "description": "What KLT Cyber serves to the church website (spec 0026). Guide: docs/api/website-api.md.\n\nPick an environment (Development or Staging) holding baseUrl, apiKey and signingSecret. POST requests are signed by the collection pre-request script.\n\nFolders 1 to 3 are safe: they never write or push. Folder 4 sends a real push to that environment's test phones; run it on development or staging only, after telling the app team.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request in this collection.",
          "// 1. `nowIso` is the current time, for `updated_at` in request bodies.",
          "pm.variables.set(\"nowIso\", new Date().toISOString());",
          "",
          "// 2. Signs POST requests (spec 0026, AC-4): X-Klt-Timestamp is the Unix time",
          "// in seconds, X-Klt-Signature is sha256= + hex HMAC-SHA256 of",
          "// \"<timestamp>.<raw body>\" under the signing secret. The body is resolved and",
          "// written back first, so the bytes signed are exactly the bytes sent.",
          "if (pm.request.method === \"POST\") {",
          "    const secret = pm.environment.get(\"signingSecret\");",
          "    if (!secret) throw new Error(\"Set signingSecret in the selected environment.\");",
          "    const raw = pm.variables.replaceIn(pm.request.body ? pm.request.body.raw || \"\" : \"\");",
          "    pm.request.body.update({ mode: \"raw\", raw: raw, options: { raw: { language: \"json\" } } });",
          "    const ts = Math.floor(Date.now() / 1000).toString();",
          "    const sig = CryptoJS.HmacSHA256(ts + \".\" + raw, secret).toString(CryptoJS.enc.Hex);",
          "    pm.request.headers.upsert({ key: \"X-Klt-Timestamp\", value: ts });",
          "    pm.request.headers.upsert({ key: \"X-Klt-Signature\", value: \"sha256=\" + sig });",
          "}"
        ]
      }
    }
  ],
