{
  // Cloudflare Workers config for the admin app, deployed via the OpenNext
  // Cloudflare adapter (@opennextjs/cloudflare). See docs/DEPLOYMENT.md.
  //
  // `nodejs_compat` is mandatory: Better Auth's token/cookie handling and the
  // Convex client rely on Node APIs (e.g. node:crypto), which the edge runtime
  // does not provide. This is why the deprecated @cloudflare/next-on-pages
  // (edge-only) adapter is not used.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the connected Cloudflare Workers service (klt-cyber) so deploys
  // target the same Worker rather than creating a second one.
  "name": "klt-cyber",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }

  // ── Direct R2 access (optional) ──────────────────────────────────────────
  // The admin app normally reaches storage through the Convex R2 component
  // (convex/uploads.ts) — no binding needed. Add a binding ONLY if the Worker
  // must read/write R2 objects at the edge itself (e.g. streaming large media).
  // The bucket must already exist, or `wrangler deploy` fails. See docs/STORAGE.md.
  //
  // "r2_buckets": [
  //   { "binding": "MEDIA_BUCKET", "bucket_name": "klt-cyber-media" }
  // ]
}
